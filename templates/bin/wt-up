#!/usr/bin/env bash
# wt-up : démarre la stack Docker propre à ce worktree.
#
# À copier dans bin/ du dépôt du projet, puis à brancher sur scripts.setup
# d'orca.yaml. Chaque worktree reçoit son propre projet Compose et ses propres
# ports, liés à l'adresse du tunnel WireGuard.
#
# Dans compose.yaml, publie les ports ainsi :
#   ports:
#     - "${WT_BIND}:${WEB_PORT}:80"
set -euo pipefail

# Variables de port à attribuer, une par port publié dans compose.yaml.
PORT_VARS=(WEB_PORT DB_PORT)
# Adresse du VPS dans le tunnel, lue sur l'interface wg0 : les ports ne sont
# jamais publiés sur Internet.
wg_ip="$(ip -4 -o addr show dev wg0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)"
WT_BIND="${WT_BIND:-${wg_ip:-10.8.0.1}}"
# Plage dans laquelle les ports sont choisis.
PORT_MIN=20000
PORT_SPAN=20000

worktree="${ORCA_WORKTREE_PATH:-$PWD}"
name="${ORCA_WORKSPACE_NAME:-$(basename "$worktree")}"
cd "$worktree"

# Nom de projet Compose : minuscules, chiffres, tirets et soulignés.
project="wt-$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | cut -c1-48 | sed 's/-*$//')"
env_file=".wt.env"

port_in_use() {
  local listeners
  listeners="$(ss -ltnH "sport = :$1" 2>/dev/null)"
  [ -n "$listeners" ]
}

port_reserved() {
  # Port déjà promis à un autre worktree de ce dépôt (stack arrêtée ou non).
  grep -hsE "^[A-Z_]+=$1\$" ../*/.wt.env "${ORCA_ROOT_PATH:-.}"/.wt.env 2>/dev/null | grep -q . || return 1
}

if [ -f "$env_file" ]; then
  echo "wt-up : ports déjà attribués ($env_file), réutilisés."
else
  # Point de départ stable, tiré du nom du worktree. Deux noms peuvent tomber
  # sur le même port : on avance jusqu'au premier port libre.
  hash="$(printf '%s' "$name" | cksum | cut -d' ' -f1)"
  port=$(( PORT_MIN + hash % PORT_SPAN ))
  {
    printf 'COMPOSE_PROJECT_NAME=%s\n' "$project"
    printf 'WT_BIND=%s\n' "$WT_BIND"
    for var in "${PORT_VARS[@]}"; do
      tries=0
      while port_in_use "$port" || port_reserved "$port"; do
        port=$(( port + 1 ))
        [ "$port" -lt $(( PORT_MIN + PORT_SPAN )) ] || port=$PORT_MIN
        tries=$(( tries + 1 ))
        [ "$tries" -lt "$PORT_SPAN" ] || { echo "wt-up : aucun port libre." >&2; exit 1; }
      done
      printf '%s=%s\n' "$var" "$port"
      port=$(( port + 1 ))
    done
  } > "$env_file.tmp"
  mv "$env_file.tmp" "$env_file"
fi

docker compose --env-file "$env_file" -p "$project" up -d

echo "wt-up : projet $project démarré. Ports (joignables par le tunnel seulement) :"
grep -E '_PORT=' "$env_file" | sed "s/^\(.*\)=\(.*\)$/  \1  http:\/\/$WT_BIND:\2/"
