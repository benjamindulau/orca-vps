# Configuration de bootstrap.sh.
#
# Copie ce fichier en config.env, à côté de bootstrap.sh sur le VPS, puis :
#   chmod 600 config.env
# Le script refuse de démarrer si config.env est lisible par d'autres comptes.
# Toutes les valeurs sont facultatives sauf l'identité Git ; si elle manque
# et que le script tourne dans un terminal, il la demande et l'enregistre.
# Après install, la copie de référence est /etc/orca-vps/config.env.

# --- Identité Git de l'agent (obligatoire) -----------------------------------
# Le compte GitHub dédié à l'agent, jamais ton compte personnel.
GIT_USER_NAME=''
GIT_USER_EMAIL=''

# Jeton GitHub du compte agent pour la CLI gh (facultatif, secret). Sans lui,
# la connexion se fait à la main : sudo orca-vps gh-login.
#GH_TOKEN=''

# --- Compte ------------------------------------------------------------------
# Compte sans sudo qui fait tourner Orca et les agents.
#ORCA_USER='dev'
# Dossier parent des projets, relatif au dossier personnel de ce compte.
#ORCA_CODE_DIR='code'
# Fichier authorized_keys à copier vers ce compte. Par défaut : celui du compte
# qui lance sudo, puis celui de root (les clés à commande forcée sont écartées).
#SSH_KEYS_FROM='/home/ubuntu/.ssh/authorized_keys'

# --- Tunnel WireGuard --------------------------------------------------------
# Plan d'adressage commun à tous tes VPS. À ne changer que s'il chevauche un
# autre de tes réseaux, et alors à l'identique sur tous les VPS.
#WG_NET='10.8.0.0/16'
# Adresse de ce serveur dans le tunnel, propre à chaque VPS : 10.8.0.1,
# 10.8.1.1, 10.8.2.1… Si elle n'est pas renseignée, install la demande.
#WG_SERVER_IP='10.8.0.1'
#WG_PORT='51820'
# Appareils à créer, au format nom:adresse, séparés par des espaces. Garde la
# même adresse pour un appareil sur tous tes VPS : il les joint ainsi tous
# par un seul tunnel.
#WG_PEERS='mac:10.8.0.2 phone:10.8.0.3'
# Voie recommandée : fournir la clé publique de chaque appareil. Le serveur ne
# crée alors aucune clé privée pour lui. Le nom est en majuscules, les tirets
# deviennent des soulignés (appareil « mac » : WG_PEER_MAC_PUBKEY).
#WG_PEER_MAC_PUBKEY=''
#WG_PEER_PHONE_PUBKEY=''
# Adresse publique écrite dans les configurations clientes. Détectée par
# défaut ; à renseigner si le VPS est derrière un NAT ou a un nom DNS.
#PUBLIC_ENDPOINT=''

# --- Orca --------------------------------------------------------------------
#ORCA_PORT='6768'
# deb : paquet complet (panneaux navigateur, environ 200 Mo, paquets graphiques).
# tarball : archive « serveur seul » dans /opt/orca-server (environ 65 Mo).
#ORCA_INSTALL_METHOD='deb'
# latest, ou un numéro de version à épingler (par exemple 1.4.261).
#ORCA_VERSION='latest'
# Noms rendus injoignables par /etc/hosts, séparés par des espaces. Par défaut :
# le site de l'éditeur d'Orca, sa télémétrie et la mise à jour du navigateur
# embarqué (liste dans bootstrap.sh). Une chaîne vide ne bloque rien.
#ORCA_BLOCKED_HOSTS=''
# Plafond mémoire par terminal Orca (par exemple 8G). Vide : aucun plafond.
#ORCA_TERMINAL_MEMORY_MAX=''

# --- Claude Code -------------------------------------------------------------
# login : connexion manuelle (orca-vps claude-login), toutes les fonctions.
# token : jeton d'un an créé sur ton Mac avec « claude setup-token » ; il ne
#         sert qu'aux requêtes de modèle (ni Remote Control ni connecteurs).
#CLAUDE_AUTH='login'
# Secret, requis si CLAUDE_AUTH=token. Lisible par les agents, par construction.
#CLAUDE_CODE_OAUTH_TOKEN=''
# Écrit dans ~/.claude/settings.json (clé model) si renseigné.
#CLAUDE_DEFAULT_MODEL=''

# --- Docker ------------------------------------------------------------------
# group : le compte rejoint le groupe docker (équivalent root sur la machine).
# rootless : démon Docker propre au compte, sans droits root.
#DOCKER_MODE='group'

# --- Système -----------------------------------------------------------------
# Taille du fichier d'échange, 0 pour ne pas en créer.
#SWAP_SIZE='4G'
#TIMEZONE='Europe/Paris'
